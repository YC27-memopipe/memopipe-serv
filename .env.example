# Chaîne de connexion Postgres (Prisma Postgres, Neon, Render…). Obligatoire en production.
# Sans cette variable, le hub utilise PGlite, un Postgres embarqué stocké dans .data/pglite (local uniquement).
DATABASE_URL=

# Jeton partagé par l'équipe : obligatoire pour le parcours Découvrir.
# Exigé par /api/scenarios et /api/agent/* quand il est défini.
# Le script et l'agent de memopipe-local l'envoient avec CANARY_TEAM_TOKEN.
MEMOPIPE_TEAM_TOKEN=

# Diagnostic IA : clé uniquement sur le serveur, jamais dans NEXT_PUBLIC_*.
# AI_MODEL : identifiant d'un modèle de votre compte qui supporte Structured Outputs.
OPENAI_API_KEY=
AI_MODEL=
# Facultatif ; défaut OpenAI. Compatible Chat Completions + JSON Schema strict.
AI_BASE_URL=https://api.openai.com/v1
