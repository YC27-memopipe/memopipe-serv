# Postgres Neon (posé automatiquement par l'intégration Neon de Vercel).
# Sans cette variable, le hub utilise PGlite, un Postgres embarqué stocké dans .data/pglite.
DATABASE_URL=

# Jeton partagé par l'équipe : le script memopipe:analyze l'envoie à POST /api/scenarios.
# Laisser vide en local pour ne pas exiger de jeton.
MEMOPIPE_TEAM_TOKEN=
